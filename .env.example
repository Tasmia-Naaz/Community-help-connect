# ==============================================================
# COMMUNITY HELP CONNECT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and update the values for your local system
# ==============================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32chars

# MySQL Database Credentials
# Default standard MySQL port is 3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=community_help_db

# Full Database URI (Optional override; if unset, auto-constructed from DB_* variables)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
# DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@127.0.0.1:3306/community_help_db?charset=utf8mb4

# Testing / Fallback: Set to 1 if you want to test without a running MySQL instance
# (Uses SQLite database in instance/community_help_test.db)
USE_SQLITE_FALLBACK=0
